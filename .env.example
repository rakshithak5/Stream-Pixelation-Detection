# ============================================
# API Settings
# ============================================
API_TITLE="Live Stream Quality Monitor"
API_VERSION="1.0.0"
API_HOST="0.0.0.0"
API_PORT=8000

# ============================================
# Detection Thresholds - Tier 1 (Spatial)
# ============================================
# Edge detection threshold (0-1 range)
# Lower = more sensitive, Higher = fewer false positives
EDGE_THRESHOLD=0.18

# Color quantization threshold (0-1 range)
COLOR_QUANT_THRESHOLD=0.55

# ============================================
# Voting Thresholds (Multi-Signal Consensus)
# ============================================
# Edge vote threshold (0-1 range, as percentage: 0.08 = 8%)
EDGE_VOTE_THRESHOLD=0.08

# Grid vote threshold (0-1 range, as percentage: 0.08 = 8%)
GRID_VOTE_THRESHOLD=0.08

# MVAD vote threshold (0-1 range, as percentage: 0.40 = 40%)
MVAD_VOTE_THRESHOLD=0.40

# BRISQUE vote threshold (0-100 range)
BRISQUE_VOTE_THRESHOLD=55.0

# ============================================
# Alert Thresholds
# ============================================
# Image alert threshold (0-1 range)
IMAGE_ALERT_THRESHOLD=0.35

# Video sliding window size (frames)
VIDEO_WINDOW_SIZE=15

# Minimum flagged frames in window to trigger alert
VIDEO_MIN_FLAGGED_FRAMES=8

# ============================================
# Temporal Refinement (Video Only)
# ============================================
# Scene cut detection threshold (SAD value)
SCENE_CUT_SAD_THRESHOLD=30.0

# Frames required for block persistence
BLOCK_PERSISTENCE_FRAMES=3

# QP threshold for bitstream hint
QP_THRESHOLD=40

# Color shift saturation delta threshold
COLOR_SHIFT_SATURATION_DELTA=25.0

# ============================================
# Composite Score Weights (must sum to 1.0)
# ============================================
BOUNDARY_EDGE_WEIGHT=0.40
MVAD_BLOCKINESS_WEIGHT=0.25
COLOR_QUANT_WEIGHT=0.20
MVAD_PIXELATION_WEIGHT=0.10
BRISQUE_WEIGHT=0.05

# ============================================
# Model Settings
# ============================================
# Path to MVAD checkpoint (relative to project root)
MVAD_MODEL_PATH=MVAD_repo/logs/checkpoints/mvad.ckpt

# Use InceptionV3 fallback if MVAD unavailable
USE_INCEPTION_FALLBACK=true

# Device: "cuda" for GPU, "cpu" for CPU
DEVICE=cpu

# ============================================
# Performance
# ============================================
MAX_WORKERS=4
FRAME_BATCH_SIZE=8

# ============================================
# Redis (for distributed stream state)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
USE_REDIS=false
